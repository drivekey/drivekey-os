{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drivekey.app/schemas/wallet-metadata.schema.json",
  "title": "DriveKey wallet metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chain", "chainId", "address", "deviceId", "createdAt"],
  "properties": {
    "version": { "const": 1 },
    "chain": { "const": "robinhood-mainnet" },
    "chainId": { "const": 4663 },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
