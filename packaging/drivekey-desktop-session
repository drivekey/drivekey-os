#!/bin/bash
set -euo pipefail
[[ $EUID == 0 && $# == 0 && -f /etc/drivekey-live ]] || exit 1
ulimit -c 0
/usr/local/bin/drivekey-isolate
/usr/bin/python3 /opt/drivekey/drivekey_rtc.py
exec 9>/run/drivekey-session.lock
flock -n 9 || { echo 'Another wallet session is active.'; exit 1; }
while read -r source; do
  [[ $source == /dev/* && $source != /dev/loop* ]] || continue
  lsblk -snro TRAN "$(readlink -f "$source")" | grep -qx usb || { echo 'Non-USB storage mounted.'; exit 1; }
done < <(findmnt -rn -o SOURCE)
mapfile -t devices < <(blkid -t LABEL=DRIVEKEY -o device)
[[ ${#devices[@]} == 1 ]] || { echo 'Exactly one DRIVEKEY exchange partition required.'; exit 1; }
lsblk -snro TRAN "${devices[0]}" | grep -qx usb || exit 1
mkdir -p /mnt/drivekey
mountpoint -q /mnt/drivekey && exit 1
uid=$(id -u user); gid=$(id -g user)
mount -t vfat -o "nosuid,nodev,noexec,uid=$uid,gid=$gid,fmask=0077,dmask=0077" "${devices[0]}" /mnt/drivekey
trap 'sync; umount /mnt/drivekey' EXIT
mkdir -p /mnt/drivekey/DriveKey
status=0
runuser -u user -- env -i HOME=/home/user DISPLAY=:0 PATH=/usr/bin:/bin LANG=en_US.UTF-8 TZ=UTC /usr/bin/python3 /opt/drivekey/drivekey-desktop.py || status=$?
sync
umount /mnt/drivekey
trap - EXIT
if [[ $status == 42 ]]; then /sbin/poweroff; else exit "$status"; fi
