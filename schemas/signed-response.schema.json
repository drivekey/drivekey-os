{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drivekey.app/schemas/signed-response.schema.json",
  "title": "DriveKey signed response",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "deviceId", "rawSignedTransaction", "signer", "transactionHash", "signedAt"],
  "properties": {
    "version": { "const": 1 }, "requestId": { "type": "string", "format": "uuid" }, "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rawSignedTransaction": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }, "signer": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "transactionHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }, "signedAt": { "type": "string", "format": "date-time" }
  }
}
