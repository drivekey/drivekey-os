{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drivekey.app/schemas/unsigned-request.schema.json",
  "title": "DriveKey unsigned request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "deviceId", "createdAt", "expiresAt", "chainId", "from", "to", "value", "nonce", "gasLimit", "type", "maxFeePerGas", "maxPriorityFeePerGas", "unsignedTransaction", "fingerprint"],
  "properties": {
    "version": { "const": 1 }, "requestId": { "type": "string", "format": "uuid" }, "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "createdAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" }, "chainId": { "const": 4663 },
    "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "value": { "type": "string", "pattern": "^[0-9]+$" }, "nonce": { "type": "string", "pattern": "^[0-9]+$" }, "gasLimit": { "type": "string", "pattern": "^[0-9]+$" },
    "type": { "const": 2 }, "maxFeePerGas": { "type": "string", "pattern": "^[0-9]+$" }, "maxPriorityFeePerGas": { "type": "string", "pattern": "^[0-9]+$" },
    "unsignedTransaction": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }, "fingerprint": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
