{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "signer.ts",
    "worker.ts",
    "receive.ts",
    "online/**/*.ts",
    "merchant/**/*.ts",
    "engine/**/*.ts",
    "tools/**/*.ts"
  ]
}
